# Neon PostgreSQL Credentials
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=dpis_db
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSLMODE=require

# Full connection string (use this in SQLAlchemy)
DATABASE_URL=postgresql://your_username:your_password@your-neon-host.neon.tech/dpis_db?sslmode=require

# App Settings
APP_ENV=development
DEBUG=True
